+    new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const detail = getPendingById().get(pendingId);
+        if (detail) detail.streamedBytes = (detail.streamedBytes ?? 0) + (chunk?.byteLength ?? 0);
+        controller.enqueue(chunk);
+      },
+    })
+  );
+}
