+++ b/tests/unit/loadout-features.test.ts
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: Apache-2.0
+// Loadout 1.1 defaults and feature switches against an isolated database (no network).
+import test from "node:test";
+import assert from "node:assert/strict";
+import { getSettings } from "../../src/lib/db/settings.ts";
+import { getCompressionSettings } from "../../src/lib/db/compression.ts";
+import { getFeatureFlagOverride } from "../../src/lib/db/featureFlags.ts";
+import { getPiiSettings } from "../../src/lib/db/piiSettings.ts";
+import { resolveResilienceSettings } from "../../src/lib/resilience/settings.ts";
+import { resolveVisionBridgeRuntimeSettings } from "../../src/shared/constants/modalityBridgeDefaults.ts";
+import { applyReleaseDefaults, CHINESE_PII_PATTERNS } from "../../src/lib/loadoutPhase1/releaseDefaults.ts";
+import { featureList, featureOption, featureSet } from "../../src/lib/loadoutPhase1/control/features.ts";
+import { kvGet } from "../../src/lib/loadoutPhase1/control/shared.ts";
+
+test("release defaults: queue off, cache off, 1.0 safety kept, bridge off", async () => {
+  await applyReleaseDefaults();
+  const s = (await getSettings()) as Record<string, any>;
+  assert.equal(resolveResilienceSettings(s).requestQueue.autoEnableApiKeyProviders, false);
+  assert.equal(s.semanticCacheEnabled, false);
+  assert.equal(s.credentialRedactionEnabled, true);
+  assert.equal(s.promptCacheAffinityEnabled, false);
+  assert.equal(s.disableSessionStickiness, true);
+  assert.equal(s.mcpEnabled, false);
+  assert.equal(resolveVisionBridgeRuntimeSettings(s).enabled, false);
+  assert.equal(getFeatureFlagOverride("INJECTION_GUARD_MODE"), "off");
+  assert.equal(getFeatureFlagOverride("PII_REDACTION_ENABLED"), "false");
+  assert.equal((await getCompressionSettings()).enabled, false);
+  const ids = getPiiSettings().customPatterns.map((p: { id: string }) => p.id);
+  for (const p of CHINESE_PII_PATTERNS) assert.ok(ids.includes(p.id), p.id);
+  assert.deepEqual(
+    kvGet<string[]>("releaseDefaults", []).sort(),
+    ["1.1-feature-defaults", "1.1-request-queue-off", "1.1-response-cache-off"]
+  );
+});
+
+test("release defaults run once: a later choice is kept", async () => {
+  await featureSet("credential_mask", false);
+  await applyReleaseDefaults();
+  assert.equal(((await getSettings()) as Record<string, any>).credentialRedactionEnabled, false);
+  await featureSet("credential_mask", true);
+});
+
+test("Chinese PII patterns match mainland formats and leave other digits alone", () => {
+  const re = (id: string) => {
+    const p = CHINESE_PII_PATTERNS.find((x) => x.id === id)!;
+    return new RegExp(p.pattern, p.flags);
+  };
+  assert.match("我的手机是13812345678", re("loadout-cn-mobile"));
+  assert.match("+86 13912345678", re("loadout-cn-mobile"));
+  assert.doesNotMatch("订单号 213812345678901", re("loadout-cn-mobile"));
+  assert.match("身份证 11010519491231002X 请保密", re("loadout-cn-id"));
+  assert.doesNotMatch("时间戳 1793896662168", re("loadout-cn-id"));
+  assert.match("卡号 6222021234567890123", re("loadout-cn-bankcard"));
+});
+
+test("feature list: every switch, grouped, with the right defaults", async () => {
+  const list = await featureList();
+  const by = Object.fromEntries(list.features.map((f) => [f.key, f]));
+  assert.deepEqual(Object.keys(by).sort(), [
+    "cache_affinity",
+    "compression",
+    "credential_mask",
+    "injection_guard",
+    "mcp",
+    "memory",
+    "modality_bridge",
+    "pii_redaction",
+    "response_cache",
+  ]);
+  assert.equal(by.credential_mask.enabled, true);
+  for (const key of ["response_cache", "cache_affinity", "compression", "pii_redaction", "injection_guard", "memory", "modality_bridge", "mcp"])
+    assert.equal(by[key].enabled, false, key);
+  assert.equal(by.response_cache.stores_content, true);
+  assert.equal(by.memory.stores_content, true);
+  assert.equal(by.compression.stores_content, false, "the light level removes nothing it keeps");
+});
+
+test("compression: levels map to stacked pipelines; model level needs the AI pack", async () => {
+  await featureSet("compression", true);
+  let c = (await getCompressionSettings()) as Record<string, any>;
+  assert.equal(c.enabled, true);
+  assert.equal(c.defaultMode, "stacked");
+  const on = (cfg: Record<string, any>) =>
+    Object.entries(cfg.engines).filter(([, t]) => (t as { enabled: boolean }).enabled).map(([id]) => id).sort();
+  assert.deepEqual(on(c), ["caveman", "rtk"]);
+  assert.equal(c.engines.caveman.level, "lite");
+  assert.equal(c.cavemanConfig.autoDetectLanguage, true);
+  await featureOption("compression", "level", "standard");
+  c = (await getCompressionSettings()) as Record<string, any>;
+  assert.deepEqual(on(c), ["caveman", "rtk", "session-dedup"]);
+  const view = (await featureList()).features.find((f) => f.key === "compression")!;
+  assert.equal(view.stores_content, true);
+  const model = view.options[0].choices.find((c) => c.value === "model")!;
+  assert.equal(model.available, false);
+  await assert.rejects(featureOption("compression", "level", "model"), /AI 组件/);
+  await featureSet("compression", false);
+  c = (await getCompressionSettings()) as Record<string, any>;
+  assert.equal(c.enabled, false);
+  assert.equal(c.defaultMode, "off");
+});
+
+test("switches write OmniRoute's own settings", async () => {
+  await featureSet("cache_affinity", true);
+  let s = (await getSettings()) as Record<string, any>;
+  assert.equal(s.promptCacheAffinityEnabled, true);
+  assert.equal(s.disableSessionStickiness, false);
+  await featureSet("cache_affinity", false);
+  await featureSet("injection_guard", true);
+  assert.equal(getFeatureFlagOverride("INJECTION_GUARD_MODE"), "block");
+  await featureSet("injection_guard", false);
+  await featureSet("pii_redaction", true);
+  assert.equal(getFeatureFlagOverride("PII_REDACTION_ENABLED"), "true");
+  await featureSet("pii_redaction", false);
+  await featureSet("modality_bridge", true);
+  s = (await getSettings()) as Record<string, any>;
+  assert.equal(resolveVisionBridgeRuntimeSettings(s).enabled, true);
+  await featureSet("modality_bridge", false);
+  await assert.rejects(featureSet("nope", true), /未知功能/);
+});
+
+test("memory: a Chinese question retrieves the Chinese fact (keyword search)", async () => {
+  const { createMemory } = await import("../../src/lib/memory/store.ts");
+  const { retrieveMemories } = await import("../../src/lib/memory/retrieval.ts");
+  await createMemory({
+    apiKeyId: "zh-key",
+    sessionId: null,
+    type: "factual",
+    key: "preference:typescript",
+    content: "我喜欢用 TypeScript 写后端服务",
+    metadata: {},
+    expiresAt: null,
+  } as never);
+  await createMemory({
+    apiKeyId: "zh-key",
+    sessionId: null,
+    type: "factual",
+    key: "pattern:weather",
+    content: "今天天气很好",
+    metadata: {},
+    expiresAt: null,
+  } as never);
+  const found = await retrieveMemories("zh-key", { query: "后端服务用什么语言写比较好？", strategy: "hybrid" } as never);
+  assert.ok(found.some((m) => m.content.includes("TypeScript")), JSON.stringify(found.map((m) => m.content)));
+  assert.ok(!found.some((m) => m.content.includes("天气")));
+});
