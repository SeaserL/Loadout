@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: Apache-2.0
+// Loadout 1.1: each compression level written by the feature switch must turn into a plan that
+// actually runs the intended engines, and Chinese filler must come out of older user messages.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { getCompressionSettings } from "../../src/lib/db/compression.ts";
+import { featureOption, featureSet } from "../../src/lib/loadoutPhase1/control/features.ts";
+import {
+  applyCompressionAsync,
+  selectCompressionPlan,
+} from "../../open-sse/services/compression/strategySelector.ts";
+
+const text = "请帮我看看这个请求为什么失败，我已经申请了权限。" + "日志里一直出现连接超时的错误。".repeat(6);
+const body = () => ({
+  model: "deepseek-chat",
+  messages: [
+    { role: "user", content: text },
+    { role: "assistant", content: "好" },
+    { role: "user", content: "再看一下：" + text },
+  ],
+});
+const ctx = { provider: "openai", targetFormat: "openai", model: "deepseek-chat" };
+
+async function planFor(level: string) {
+  await featureOption("compression", "level", level);
+  const config = await getCompressionSettings();
+  return { config, plan: selectCompressionPlan(config, null, 400, body(), ctx as never) };
+}
+
+test("each level becomes a stacked plan with its own engines", async () => {
+  await featureSet("compression", true);
+  const engines = async (level: string) => (await planFor(level)).plan.stackedPipeline.map((s) => s.engine);
+  assert.deepEqual(await engines("light"), ["rtk", "caveman"]);
+  assert.deepEqual(await engines("standard"), ["session-dedup", "rtk", "caveman"]);
+  assert.deepEqual(await engines("strong"), ["session-dedup", "rtk", "caveman"]);
+  await featureSet("compression", false);
+  assert.equal((await planFor("light")).plan.mode, "off");
+});
+
+test("the light level removes Chinese filler and keeps words that contain 请", async () => {
+  await featureSet("compression", true);
+  const { config, plan } = await planFor("light");
+  assert.equal(plan.mode, "stacked");
+  const result = await applyCompressionAsync(body(), plan.mode as never, {
+    model: "deepseek-chat",
+    config: { ...config, stackedPipeline: plan.stackedPipeline } as never,
+  });
+  const messages = (result as unknown as { body: { messages: { content: string }[] } }).body.messages;
+  const all = messages.map((m) => m.content).join("\n");
+  assert(all.includes("这个请求为什么失败") && all.includes("申请了权限"), all.slice(0, 120));
+  assert(!messages[0].content.startsWith("请帮我"), "filler kept: " + messages[0].content.slice(0, 30));
+  await featureSet("compression", false);
+});
