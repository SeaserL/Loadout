# Normalize line endings: LF in the repository and working tree
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The backend's record stays byte for byte what the working copy has
backend/*.patch -text
backend/src/** -text

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
